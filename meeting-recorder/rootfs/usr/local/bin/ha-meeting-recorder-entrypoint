#!/usr/bin/env bash
set -euo pipefail

OPTIONS_FILE="/data/options.json"
RUNTIME_DIR="/tmp/runtime-ubuntu"
MEDIA_DIR="/media/meeting-recorder"
STATE_DIR="/data/meeting-recorder"
CHROME_PROFILE_ROOT="/data/chrome-profile"
CHROME_PROFILE_DIR="${CHROME_PROFILE_ROOT}/google-chrome"
CHROME_CONFIG_DIR="/home/ubuntu/.config"
CHROME_CONFIG_PATH="${CHROME_CONFIG_DIR}/google-chrome"

read_option() {
  local key="$1"
  python3 - "$OPTIONS_FILE" "$key" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
key = sys.argv[2]

if not path.exists():
    print("")
    raise SystemExit(0)

try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    print("")
    raise SystemExit(0)

value = data.get(key, "")
print(value if value is not None else "")
PY
}

shm_size_mb="$(read_option shm_size_mb)"
shm_size_mb="${shm_size_mb:-2048}"

if ! [[ "${shm_size_mb}" =~ ^[0-9]+$ ]] || (( shm_size_mb < 512 || shm_size_mb > 4096 )); then
  echo "[meeting-recorder] Invalid shm_size_mb. Expected an integer between 512 and 4096."
  exit 78
fi

if grep -qs ' /dev/shm ' /proc/mounts; then
  mount -o remount,size="${shm_size_mb}M" /dev/shm
else
  mkdir -p /dev/shm
  mount -t tmpfs -o size="${shm_size_mb}M" tmpfs /dev/shm
fi

# Output files are user-visible through Home Assistant's /media mapping.
mkdir -p "${MEDIA_DIR}"
chown 1000:1000 "${MEDIA_DIR}"

# /data itself is Supervisor-managed and may be root-owned. The recording API
# runs as ubuntu so give it a dedicated persistent state directory instead of
# writing directly into /data.
mkdir -p "${STATE_DIR}"
chown 1000:1000 "${STATE_DIR}"
chmod 0750 "${STATE_DIR}"

# Persist the complete Google Chrome profile across add-on restarts and image
# updates. Chrome stores preferences, cookies, site permissions, extensions and
# session state below ~/.config/google-chrome on Linux.
mkdir -p "${CHROME_PROFILE_DIR}" "${CHROME_CONFIG_DIR}"
if [[ ! -f "${CHROME_PROFILE_ROOT}/.initialized" ]]; then
  if [[ -d "${CHROME_CONFIG_PATH}" && ! -L "${CHROME_CONFIG_PATH}" ]]; then
    cp -a "${CHROME_CONFIG_PATH}/." "${CHROME_PROFILE_DIR}/" 2>/dev/null || true
  fi
  chown -R 1000:1000 "${CHROME_PROFILE_ROOT}"
  touch "${CHROME_PROFILE_ROOT}/.initialized"
  chown 1000:1000 "${CHROME_PROFILE_ROOT}/.initialized"
fi
if [[ -e "${CHROME_CONFIG_PATH}" || -L "${CHROME_CONFIG_PATH}" ]]; then
  rm -rf "${CHROME_CONFIG_PATH}"
fi
ln -s "${CHROME_PROFILE_DIR}" "${CHROME_CONFIG_PATH}"
chown -h 1000:1000 "${CHROME_CONFIG_PATH}"
chown 1000:1000 "${CHROME_PROFILE_ROOT}" "${CHROME_PROFILE_DIR}" "${CHROME_CONFIG_DIR}"

# These locks refer to processes/sockets in the previous container instance.
# Removing stale values is safe before Chrome is launched and prevents a
# persisted profile from being mistaken for an already-running local instance.
rm -f \
  "${CHROME_PROFILE_DIR}/SingletonCookie" \
  "${CHROME_PROFILE_DIR}/SingletonLock" \
  "${CHROME_PROFILE_DIR}/SingletonSocket"

# Nginx owns the Home Assistant Ingress port. Selkies stays private behind it.
export SELKIES_PORT=8081
export SELKIES_ENABLE_HTTPS=false
export SELKIES_ENABLE_BASIC_AUTH=false

# Stable virtual capture devices, but physical client devices are requested
# only while the remote application actually uses them.
export SELKIES_AUDIO_ENABLED=true
export SELKIES_MICROPHONE_ENABLED=true
export SELKIES_WEBCAM_ENABLED=true
export SELKIES_MICROPHONE_ON_START=demand
export SELKIES_WEBCAM_ON_START=demand
export SELKIES_GAMEPAD_ENABLED=false
export SELKIES_COMMAND_ENABLED=false

if [[ ! -x /etc/container-entrypoint.sh ]]; then
  echo "[meeting-recorder] Upstream Selkies entrypoint not found."
  exit 70
fi
if [[ ! -x /usr/bin/sudo-root ]]; then
  echo "[meeting-recorder] Upstream sudo helper not found."
  exit 70
fi

echo "[meeting-recorder] /dev/shm target: ${shm_size_mb} MiB."
echo "[meeting-recorder] Selkies internal port: 8081."
echo "[meeting-recorder] Meeting Recorder gateway/API ingress port: 8080."
echo "[meeting-recorder] Recordings directory: ${MEDIA_DIR}."
echo "[meeting-recorder] State directory: ${STATE_DIR}."
echo "[meeting-recorder] Persistent Chrome profile: ${CHROME_PROFILE_DIR}."

nginx -t
nginx

# The API runs as the same desktop user as PipeWire/Pulse. It may start before
# the audio server; individual recording requests wait for audio readiness.
export XDG_RUNTIME_DIR="${RUNTIME_DIR}"
export PULSE_SERVER="unix:${RUNTIME_DIR}/pulse/native"
export PYTHONPATH="/opt/meeting-recorder-python${PYTHONPATH:+:${PYTHONPATH}}"

/usr/bin/sudo-root -E -H -u ubuntu -- /usr/local/bin/meeting-recorder-api &
API_PID=$!

cleanup() {
  kill "${API_PID}" 2>/dev/null || true
  nginx -s quit 2>/dev/null || true
}
trap cleanup EXIT TERM INT

echo "[meeting-recorder] Starting persistent Selkies desktop."
exec /usr/bin/sudo-root -E -H -u ubuntu -- /etc/container-entrypoint.sh "$@"
